[
 {
  "id": "cmp:krishna-portrayal",
  "title": "Kṛṣṇa across the Mahābhārata, Gītā, Harivaṃśa, Viṣṇu Purāṇa and Bhāgavata Purāṇa",
  "subject": "char:krishna",
  "question": "How is Kṛṣṇa presented — hero, partial descent, or the supreme Lord himself — and how much of his cowherd childhood is told?",
  "rows": [
   {
    "text": "text:mahabharata",
    "locator": "MBh (CE) 1.61.90; 1.189.31; 2.38.4–9; 5.129; 16.5.19–20",
    "statement": "A Vṛṣṇi prince, ally and charioteer of the Pāṇḍavas, called a portion (aṃśa) of Nārāyaṇa (1.61.90) and born from Nārāyaṇa’s black hair (1.189.31). He reveals a cosmic form at the Kaurava court (5.129) and dies from a hunter’s arrow (16.5). His childhood exploits (Pūtanā, Govardhana) are only alluded to, in Śiśupāla’s mocking speech (2.38.4–9).",
    "sources": [
     {
      "source": "src:gretil-mbh-ce",
