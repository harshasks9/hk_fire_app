{
  "name": "hk-fire-research",
  "version": "1.0.0",
  "private": true,
  "description": "Forensic memoranda on listed alternative asset managers — plain static pages behind a shared key.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node --experimental-strip-types --disable-warning=ExperimentalWarning build.ts",
