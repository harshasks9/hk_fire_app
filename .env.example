# Copy to .env.local for local development. Everything is optional.
# APP_PASSWORD=            # set to require a password; unset = open (demo) access
# SESSION_SECRET=          # openssl rand -hex 32 — signs the login cookie
# DATABASE_URL=            # Postgres (Neon / Vercel Postgres / Supabase). Unset = embedded PGlite in .data/
# GEMINI_API_KEY=          # enables Gemini for extraction, summaries, Q&A and real embeddings
# ANTHROPIC_API_KEY=       # alternative / preferred LLM for extraction, summaries and Q&A
# AI_PROVIDER=             # 'anthropic' | 'gemini' | 'local' (default: auto-detect from keys)
# CRON_SECRET=             # protects /api/cron/*
# APP_URL=https://notes.hkfire.app

# --- SaaS (all optional) ---
# RESEND_API_KEY=          # sends verification, reset and invitation emails through Resend; unset = links are shown in the UI
# EMAIL_FROM=              # "Notes <hello@yourdomain.com>" (a domain verified in Resend)
# STRIPE_SECRET_KEY=       # enables online upgrades (Checkout + customer portal); unset = the admin assigns plans by hand
# STRIPE_WEBHOOK_SECRET=   # signing secret of the webhook pointed at /api/billing/webhook
# STRIPE_PRICE_PRO=        # price id of the Pro subscription
# STRIPE_PRICE_TEAM=       # price id of the Team subscription
